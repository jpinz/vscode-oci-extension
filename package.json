{
  "name": "oci-layout-explorer",
  "displayName": "OCI Layout Explorer",
  "description": "Interactively explore container images saved as OCI image layouts.",
  "version": "0.0.1",
  "license": "GPL-3.0-only",
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "oci",
    "container",
    "image",
    "explorer"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ociExplorer.openLayout",
        "title": "Open OCI Layout Folder"
      },
      {
        "command": "ociExplorer.openLayoutFromExplorer",
        "title": "Open as OCI Layout"
      },
      {
        "command": "ociExplorer.refresh",
        "title": "Refresh OCI Layout"
      },
      {
        "command": "ociExplorer.openRawFile",
        "title": "Open OCI File"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "ociExplorer.layout",
          "name": "OCI Layout Explorer",
          "icon": "media/oci-layout.svg",
          "when": "config.ociExplorer.navigationMode != 'ui'"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "ociExplorer.layoutEditor",
        "displayName": "OCI Layout Editor",
        "priority": "default",
        "selector": [
          {
            "filenamePattern": "**/oci-layout"
          }
        ]
      }
    ],
    "configuration": {
      "title": "OCI Layout Explorer",
      "properties": {
        "ociExplorer.navigationMode": {
          "type": "string",
          "default": "both",
          "enum": [
            "tree",
            "ui",
            "both"
          ],
          "enumDescriptions": [
            "Use only the VS Code tree view for OCI layout navigation.",
            "Use only the OCI custom editor UI for navigation.",
            "Enable both the VS Code tree view and OCI custom editor UI."
          ],
          "description": "Choose whether OCI layout navigation uses the tree view, the custom editor UI, or both."
        }
      }
    },
    "menus": {
      "explorer/context": [
        {
          "command": "ociExplorer.openLayoutFromExplorer",
          "when": "explorerResourceIsFolder && resourceFsPath in ociExplorer.layoutFolders",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "ociExplorer.openLayout",
          "when": "view == ociExplorer.layout",
          "group": "navigation"
        },
        {
          "command": "ociExplorer.refresh",
          "when": "view == ociExplorer.layout",
          "group": "navigation@1"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "node --test out/test/**/*.test.js",
    "test:vscode": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.120.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.56.1",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
