{
  "name": "oci-layout-explorer",
  "displayName": "OCI Layout Explorer",
  "description": "Interactively explore container images saved as OCI image layouts.",
  "version": "0.0.1",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/jpinz/vscode-oci-extension"
  },
  "engines": {
    "vscode": "^1.120.0"
  },
  "publisher": "jpinz",
  "categories": [
    "Other"
  ],
  "keywords": [
    "oci",
    "container",
    "image",
    "explorer"
  ],
  "activationEvents": [
    "onCustomEditor:ociExplorer.blobViewer",
    "onView:ociExplorer.dockerImages"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ociExplorer.openLayout",
        "title": "Open OCI Layout Folder"
      },
      {
        "command": "ociExplorer.exploreImage",
        "title": "Explore Image",
        "icon": "$(search)"
      },
      {
        "command": "ociExplorer.openLayoutFromExplorer",
        "title": "Open as OCI Layout"
      },
      {
        "command": "ociExplorer.refresh",
        "title": "Refresh OCI Layout",
        "icon": "$(refresh)"
      },
      {
        "command": "ociExplorer.openRawFile",
        "title": "Open OCI File"
      },
      {
        "command": "ociExplorer.docker.refresh",
        "title": "Refresh Docker Images",
        "icon": "$(refresh)"
      },
      {
        "command": "ociExplorer.docker.openAsOciLayout",
        "title": "Open as OCI Layout",
        "icon": "$(folder-opened)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ociExplorer",
          "title": "OCI Explorer",
          "icon": "media/oci-layout.svg"
        }
      ]
    },
    "views": {
      "ociExplorer": [
        {
          "id": "ociExplorer.layout",
          "name": "OCI Layout Explorer",
          "when": "!ociExplorer.containerToolsActive"
        },
        {
          "id": "ociExplorer.dockerImages",
          "name": "Docker Images",
          "when": "!ociExplorer.containerToolsActive"
        }
      ],
      "containersView": [
        {
          "id": "ociExplorer.layout.integrated",
          "name": "OCI Layout Explorer",
          "when": "ociExplorer.containerToolsActive"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "ociExplorer.blobViewer",
        "displayName": "OCI Blob Viewer",
        "priority": "option",
        "selector": [
          {
            "filenamePattern": "**/blobs/**/*"
          },
          {
            "filenamePattern": "**/index.json"
          },
          {
            "filenamePattern": "**/oci-layout"
          }
        ]
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "ociExplorer.openLayoutFromExplorer",
          "when": "explorerResourceIsFolder && resourceFsPath in ociExplorer.layoutFolders",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "ociExplorer.exploreImage",
          "when": "view == ociExplorer.layout || view == ociExplorer.layout.integrated",
          "group": "navigation"
        },
        {
          "command": "ociExplorer.refresh",
          "when": "view == ociExplorer.layout || view == ociExplorer.layout.integrated",
          "group": "navigation@1"
        },
        {
          "command": "ociExplorer.docker.refresh",
          "when": "view == ociExplorer.dockerImages",
          "group": "navigation"
        },
        {
          "command": "ociExplorer.exploreImage",
          "when": "view == ociExplorer.dockerImages",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "ociExplorer.docker.openAsOciLayout",
          "when": "view == ociExplorer.dockerImages && viewItem == dockerImage",
          "group": "inline"
        },
        {
          "command": "ociExplorer.docker.openAsOciLayout",
          "when": "view == ociExplorer.dockerImages && viewItem == dockerImage",
          "group": "navigation"
        },
        {
          "command": "ociExplorer.docker.openAsOciLayout",
          "when": "view == vscode-containers.views.images && viewItem == image",
          "group": "images_2_general@6"
        }
      ]
    },
    "configuration": {
      "title": "OCI Layout Explorer",
      "properties": {
        "ociExplorer.docker.socketPath": {
          "type": "string",
          "default": "",
          "description": "Path to Docker daemon socket. Leave empty to use DOCKER_HOST environment variable or the platform default."
        },
        "ociExplorer.docker.exportPath": {
          "type": "string",
          "default": "",
          "description": "Directory for exported OCI layouts. Leave empty to use a temporary directory."
        },
        "ociExplorer.jsonDetectionMaxBytes": {
          "type": "number",
          "default": 8388608,
          "minimum": 1,
          "description": "Maximum file size in bytes for automatic OCI JSON detection when opening descriptor files. Files larger than this remain in their default language mode."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && node esbuild.js",
    "check-types": "tsc --noEmit",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "pretest": "npm run compile-tests && npm run lint",
    "lint": "eslint src",
    "test": "node --test out/test/**/*.test.js",
    "test:vscode": "vscode-test",
    "deploy": "vsce publish"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.120.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.1",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.3",
    "npm-run-all2": "^8.0.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  }
}
